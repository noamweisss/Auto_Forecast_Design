# Copy this file to .env for local development, then fill in real values.
# Never commit .env. The daily GitHub Actions workflow reads the same names
# from repository secrets instead of this file.
#
# Only EMAIL_ADDRESS and EMAIL_PASSWORD have no safe default. For Gmail,
# EMAIL_PASSWORD must be an app password, not the account password:
# https://myaccount.google.com/apppasswords

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
RECIPIENT_EMAIL=weissno@ims.gov.il

# Optional.
# SMTP_USERNAME: SMTP login when it differs from EMAIL_ADDRESS.
# SMTP_SECURITY: starttls or ssl; defaults to ssl on port 465, starttls otherwise.
# EMAIL_SENDER_NAME: display name shown before the sender address.
SMTP_USERNAME=
SMTP_SECURITY=
EMAIL_SENDER_NAME=IMS Forecast Automation
